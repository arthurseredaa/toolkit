{
  "name": "toolkit",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "web:dev": "pnpm -F web dev"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0"
  },
  "packageManager": "pnpm@11.19.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.19.0",
      "onFail": "download"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
